<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Плавающий помощник поверх других приложений -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Голос: распознавание и синтез -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Фоновый сервис с микрофоном -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Визуальный режим -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Телефония и контакты (действия с подтверждением) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Поиск информации -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Видимость установленных приложений (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NovaApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_nova"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_nova"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nova"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".NotesActivity"
            android:exported="false"
            android:label="@string/notes_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:label="@string/apps_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".camera.CameraAssistantActivity"
            android:exported="false"
            android:label="@string/camera_title"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- «Руки и глаза»: чтение экрана, нажатия, ввод текста, жесты. -->
        <service
            android:name=".service.NovaAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Плавающий персонаж + голосовой контур + ядро помощника. -->
        <service
            android:name=".service.FloatingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".service.TimerReceiver"
            android:exported="false" />
    </application>
</manifest>
